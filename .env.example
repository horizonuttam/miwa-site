# Contact form email (https://resend.com). Without these the form shows an error instead of sending.
RESEND_API_KEY=
CONTACT_TO_EMAIL=uttamsharma78@gmail.com
# Must be an address on a domain you've verified in Resend, e.g. website@miwa.org.in
CONTACT_FROM_EMAIL=
NEXT_PUBLIC_SITE_URL=https://www.miwa.org.in

# Writing portal (/keystatic). Leave blank to edit files locally.
# When hosted, set the GitHub repo (owner/name). The first visit to /keystatic on your
# machine with this set walks you through creating the GitHub App and fills in the
# four values below; copy them into Vercel's environment variables too.
NEXT_PUBLIC_KEYSTATIC_GITHUB_REPO=
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
NEXT_PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=
